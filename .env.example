# Admin panel backend (single source of truth across UAT and prod builds).
# Falls back to VITE_API_UAT / VITE_API_PROD if unset, for backwards compatibility.
VITE_API_BASE_URL="http://localhost:3000/api/v1"

# Kept for backward compatibility. Prefer VITE_API_BASE_URL.
VITE_API_UAT="http://localhost:3000/api/v1"
VITE_API_PROD="http://localhost:3000/api/v1"

# Customer-facing SDK endpoint (used by sdk.js). Falls back to VITE_APP_URL, then localhost.
VITE_SDK_API="http://localhost:3000/api/v1"

# Asset / image host
VITE_IMAGE="http://localhost:3000"

# Misc
VITE_APP_URL="http://localhost:3000/api/v1"
VITE_API_KEY="your_api_key_here"
